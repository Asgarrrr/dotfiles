{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "Apple",
    "color": {
      "1": "38;2;161;161;170",
      "2": "38;2;161;161;170",
      "3": "38;2;161;161;170",
      "4": "38;2;161;161;170",
      "5": "38;2;161;161;170",
      "6": "38;2;161;161;170",
      "7": "38;2;161;161;170"
    },
    "padding": {
      "right": 2
    }
  },

  "display": {
    "separator": "  ",
    "brightColor": false,
    "color": {
      "keys":  "38;2;255;199;153",
      "title": "38;2;255;255;255",
      "output": "38;2;255;255;255"
    },
    "size": {
      "ndigits": 1
    },
    "percent": {
      "type": [
        "num",
        "num-color"
      ],
      "color": {
        "green": "38;2;161;161;170",
        "yellow": "38;2;255;199;153",
        "red": "38;2;255;128;128"
      }
    },
    "key": {
      "width": 7
    }
  },

  "modules": [
    {
      "type": "title",
      "format": "{user-name}"
    },
    "break",
    {
      "type": "host",
      "key": "host"
    },
    {
      "type": "os",
      "key": "os"
    },
    {
      "type": "shell",
      "key": "shell"
    },
    {
      "type": "terminal",
      "key": "term"
    },
    "break",
    {
      "type": "cpu",
      "key": "cpu"
    },
    {
      "type": "memory",
      "key": "mem"
    },
    {
      "type": "battery",
      "key": "power"
    },
    {
      "type": "uptime",
      "key": "up"
    }
  ]
}
