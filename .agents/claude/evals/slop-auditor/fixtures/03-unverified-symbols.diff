+import pRetry from "p-retry";
+import { guard } from "express-async-validator-pro";
+import { z } from "zod";
+
+const SignupSchema = z.object({
+  email: z.string().emailStrict(),
+  age: z.number().int().positive(),
+});
+
+export const signupGuard = guard(SignupSchema, {
+  mode: "strict",
+  coerce: false,
+});
+
+export async function submitSignup(payload: unknown) {
+  const parsed = SignupSchema.parse(payload);
+
+  return pRetry(() => postSignup(parsed), {
+    retries: 3,
+    onFailedAttempt: (err) => console.warn(err.message),
+  });
+}
