Scenario: an agent added a retry helper. The logic is correct and load-bearing.
Ground truth: the code stays, nearly every comment goes. One comment earns its place.

--- a/src/retry.ts
+++ b/src/retry.ts
@@ -0,0 +1,34 @@
+// Import the sleep helper
+import { sleep } from "./sleep";
+
+// Options for the retry function
+export interface RetryOptions {
+  // The number of attempts
+  attempts: number;
+  // The base delay in milliseconds
+  baseDelayMs: number;
+}
+
+// This function retries an async operation
+export async function retry<T>(
+  fn: () => Promise<T>,
+  opts: RetryOptions,
+): Promise<T> {
+  // Declare a variable to hold the last error
+  let lastError: unknown;
+
+  // Loop over the number of attempts
+  for (let i = 0; i < opts.attempts; i++) {
+    // Try to run the function
+    try {
+      // Return the result
+      return await fn();
+    } catch (err) {
+      // Store the error
+      lastError = err;
+      // Wait before the next attempt
+      // Full jitter: the upstream rate limiter buckets by arrival time, so
+      // deterministic backoff resynchronises clients into the same bucket.
+      await sleep(Math.random() * opts.baseDelayMs * 2 ** i);
+    }
+  }
+
+  // Throw the last error
+  throw lastError;
+}
