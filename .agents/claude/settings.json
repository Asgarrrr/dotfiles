{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_SIMPLE_SYSTEM_PROMPT": "1",
    "ENABLE_TOOL_SEARCH": "auto"
  },
  "attribution": {},
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git stash*)",
      "Bash(git fetch*)",
      "Bash(git remote*)",
      "Bash(git pull*)",
      "Bash(bun *)",
      "Bash(bunx *)",
      "Bash(just *)",
      "Bash(jq *)",
      "Bash(ls*)",
      "Bash(which *)",
      "Bash(command *)",
      "Bash(mkdir *)",
      "Bash(chmod +x *)"
    ],
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/safety-pre-tool.sh",
            "timeout": 5,
            "statusMessage": "Safety check..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/format-on-edit.sh",
            "timeout": 10,
            "statusMessage": "Formatting..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/precompact.sh",
            "timeout": 10,
            "statusMessage": "Saving session digest..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/verify-on-stop.sh",
            "timeout": 5,
            "statusMessage": "Checking verification evidence..."
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "sentrux@sentrux-marketplace": true,
    "clangd-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "sentrux-marketplace": {
      "source": {
        "source": "github",
        "repo": "sentrux/sentrux"
      }
    }
  },
  "feedbackSurveyRate": 0,
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "showClearContextOnPlanAccept": true,
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "autoMemoryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "preferredNotifChannel": "ghostty",
  "agentPushNotifEnabled": false,
  "skipAutoPermissionPrompt": true
}
