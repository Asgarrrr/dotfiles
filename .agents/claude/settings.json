{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "ENABLE_TOOL_SEARCH": "auto"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git stash*)",
      "Bash(git fetch*)",
      "Bash(git remote*)",
      "Bash(git pull*)",
      "Bash(bun *)",
      "Bash(bunx *)",
      "Bash(just *)",
      "Bash(jq *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(which *)",
      "Bash(command *)",
      "Bash(mkdir *)",
      "Bash(chmod +x *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "disableClaudeAiConnectors": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/safety-pre-tool.sh",
            "timeout": 5,
            "statusMessage": "Safety check..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/format-on-edit.sh",
            "timeout": 10,
            "statusMessage": "Formatting..."
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/log-instructions.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/verify-on-stop.sh",
            "timeout": 5,
            "statusMessage": "Checking verification evidence..."
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline-command.sh",
    "refreshInterval": 60
  },
  "enabledPlugins": {
    "sentrux@sentrux-marketplace": false,
    "clangd-lsp@claude-plugins-official": false,
    "paper-desktop@paper": false,
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false,
    "code-review@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "rust-skills@rust-skills": false,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "sentrux-marketplace": {
      "source": {
        "source": "github",
        "repo": "sentrux/sentrux"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    },
    "paper": {
      "source": {
        "source": "github",
        "repo": "paper-design/agent-plugins"
      }
    },
    "rust-skills": {
      "source": {
        "source": "github",
        "repo": "actionbook/rust-skills"
      }
    }
  },
  "skillOverrides": {
    "agents-sdk": "off",
    "better-auth-best-practices": "off",
    "better-auth-security-best-practices": "off",
    "cloudflare": "off",
    "cloudflare-email-service": "off",
    "cloudflare-one": "off",
    "cloudflare-one-migrations": "off",
    "create-auth-skill": "off",
    "durable-objects": "off",
    "email-and-password-best-practices": "off",
    "organization-best-practices": "off",
    "sandbox-sdk": "off",
    "shadcn": "off",
    "turnstile-spin": "off",
    "two-factor-authentication-best-practices": "off",
    "use-railway": "off",
    "vercel-composition-patterns": "off",
    "vercel-react-best-practices": "off",
    "vercel-react-view-transitions": "off",
    "workers-best-practices": "off",
    "wrangler": "off",
    "better-accessibility": "name-only",
    "better-colors": "name-only",
    "better-interface": "name-only",
    "better-layout": "name-only",
    "better-typography": "name-only",
    "better-ui": "name-only",
    "better-writing": "name-only",
    "build-design": "name-only",
    "make-interfaces-feel-better": "name-only",
    "technical-drawing": "name-only",
    "test-deslop": "name-only",
    "web-design-guidelines": "name-only",
    "web-perf": "name-only"
  },
  "feedbackSurveyRate": 0,
  "effortLevel": "high",
  "modelSettings": {
    "glm-5.3-uncensored": {
      "effortLevel": "medium"
    }
  },
  "autoCompactWindow": 200000,
  "showClearContextOnPlanAccept": true,
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "preferredNotifChannel": "ghostty",
  "agentPushNotifEnabled": false,
  "skipAutoPermissionPrompt": true
}
